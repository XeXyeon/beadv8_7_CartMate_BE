// CartMate 수집기: trace(OTLP) → Tempo, 앱 JSON 로그 파일 → Loki
// Loki 라벨은 service · env · level만. traceId · event · orderId 등은 JSON 필드로 두고 쿼리 때 `| json`으로 거른다
// (라벨로 만들면 값 종류가 폭발해 Loki가 느려진다)
//
// 수집량 절약 (무료 한도 · 부하 테스트 대비). 값은 환경 변수로 바꾼다 — 평시 / 부하 테스트 값은 README
//   OBS_TRACE_SAMPLE_PERCENT   정상 trace를 남길 비율(%). 오류 · 느린 trace는 항상 100% 남긴다   (기본 10)
//   OBS_SLOW_TRACE_MS          이 시간(ms) 이상 걸린 trace는 항상 남긴다                           (기본 1000)
//   OBS_DROP_PLAIN_LOG_LEVELS  이 레벨의 로그 중 업무 이벤트(event)가 없는 줄은 버린다 (정규식)       (기본 DEBUG|TRACE)
//   OBS_LOG_RATE_LIMIT         서비스별 초당 로그 줄 상한 (넘으면 버림 — 오류 폭주 대비)             (기본 200)

// ===== trace: 앱 → Alloy(4317/4318) → 고르기(tail sampling) → Tempo =====
// 앱은 trace를 100% 만들어 보내고(TRACING_SAMPLING=1.0), 남길지는 여기서 trace를 다 모아 본 뒤 정한다
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.tail_sampling.default.input]
  }
}

otelcol.processor.tail_sampling "default" {
  // 첫 span을 받고 이만큼 기다렸다가 trace 전체를 보고 정한다 (서비스 간 HTTP 호출까지 들어올 시간)
  decision_wait = "10s"
  num_traces    = 20000

  // 이미 남기기로 한 trace에 늦게 온 span(Kafka 비동기 처리 등)도 같이 남긴다.
  // 버린 trace는 기억하지 않는다 → 늦게 온 span에 오류가 있으면 그 부분은 따로 판단해 남긴다
  decision_cache = {
    sampled_cache_size = 20000,
  }

  policy {
    name = "errors"
    type = "status_code"
    status_code {
      status_codes = ["ERROR"]
    }
  }

  policy {
    name = "slow"
    type = "latency"
    latency {
      threshold_ms = encoding.from_json(coalesce(sys.env("OBS_SLOW_TRACE_MS"), "1000"))
    }
  }

  policy {
    name = "sample"
    type = "probabilistic"
    probabilistic {
      sampling_percentage = encoding.from_json(coalesce(sys.env("OBS_TRACE_SAMPLE_PERCENT"), "10"))
    }
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// ===== 로그 (로컬): 앱이 observability/logs/<서비스>.log 에 쓰는 logstash JSON =====
// 파일 이름이 서비스 이름이다 (member-service.log → service="member-service")
local.file_match "app_logs" {
  path_targets = [{"__path__" = "/var/log/cartmate/*.log"}]
  sync_period  = "5s"
}

discovery.relabel "app_logs" {
  targets = local.file_match.app_logs.targets

  rule {
    source_labels = ["__path__"]
    regex         = ".*/([^/]+)\\.log"
    target_label  = "service"
  }
}

loki.source.file "app_logs" {
  targets       = discovery.relabel.app_logs.output
  forward_to    = [loki.process.cartmate.receiver]
  tail_from_end = true
}

loki.process "cartmate" {
  stage.json {
    expressions = {
      level     = "level",
      timestamp = "\"@timestamp\"",
    }
  }

  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  // 업무 이벤트(event)가 없는 줄 중 지정한 레벨은 버린다 (부하 테스트 때 INFO까지)
  stage.match {
    selector            = "{level=~\"" + coalesce(sys.env("OBS_DROP_PLAIN_LOG_LEVELS"), "DEBUG|TRACE") + "\"} != \"\\\"event\\\":\""
    action              = "drop"
    drop_counter_reason = "plain_log"
  }

  // 서비스별 초당 줄 수 상한 (오류가 폭주해도 한도를 다 쓰지 않게)
  stage.limit {
    rate              = encoding.from_json(coalesce(sys.env("OBS_LOG_RATE_LIMIT"), "200"))
    burst             = encoding.from_json(coalesce(sys.env("OBS_LOG_RATE_LIMIT"), "200")) * 2
    by_label_name     = "service"
    drop              = true
  }

  // 검색에 안 쓰는 필드 제거 (줄마다 약 30바이트)
  stage.replace {
    expression = "(\"@version\":\"1\",)"
    replace    = ""
  }

  stage.replace {
    expression = "(,\"level_value\":\\d+)"
    replace    = ""
  }

  stage.static_labels {
    values = {
      env = "local",
    }
  }

  // 파일 경로 라벨은 버린다 (라벨은 service · env · level만)
  stage.label_drop {
    values = ["filename"]
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

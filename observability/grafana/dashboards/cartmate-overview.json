{
  "uid": "cartmate-overview",
  "title": "CartMate 서비스 개요",
  "tags": ["cartmate"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "loki_ds",
        "label": "로그 저장소",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {},
        "description": "로컬은 Loki, Grafana Cloud는 grafanacloud-…-logs가 자동으로 잡힌다"
      },
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${loki_ds}" },
        "query": { "label": "service", "type": 1, "refId": "LokiVariableQueryEditor-VariableQuery" },
        "definition": "label_values(service)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "결제 보상 실패 (기간 합계)",
      "description": "event=payment.compensate(.request), result=FAILED. 0이 아니면 돈이 어긋났을 수 있음",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "${loki_ds}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service=~\".+\"} | json | event=~\"payment.compensate|payment.compensate.request\" | result=\"FAILED\" [$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "이벤트 전달 포기 (기간 합계)",
      "description": "event=outbox.failed / inbox.failed / kafka.dlt",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "${loki_ds}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service=~\".+\"} | json | event=~\"outbox.failed|inbox.failed|kafka.dlt\" [$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "결제 차감 · 환불 (기간 합계)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 4 },
      "datasource": { "type": "loki", "uid": "${loki_ds}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "{{event}} {{result}}",
          "expr": "sum by (event, result) (count_over_time({service=~\".+\"} | json | event=~\"payment.charge|payment.refund\" [$__range]))"
        }
      ],
      "fieldConfig": { "defaults": { "noValue": "0" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "서비스별 ERROR 로그",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "${loki_ds}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{service}}",
          "expr": "sum by (service) (count_over_time({service=~\"$service\", level=\"ERROR\"} [$__auto]))"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "업무 이벤트 수 (event별)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "${loki_ds}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{event}}",
          "expr": "sum by (event) (count_over_time({service=~\"$service\"} |= `\"event\":` | json | __error__=\"\" | event!=\"\" [$__auto]))"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "실패 · 포기 이벤트 (traceId를 눌러 Tempo로)",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 9 },
      "datasource": { "type": "loki", "uid": "${loki_ds}" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\"} |~ `\"event\":\"(outbox\\.failed|inbox\\.failed|kafka\\.dlt|outbox\\.retry)\"|\"result\":\"FAILED\"`"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "결제 이벤트 (payment.*)",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 9 },
      "datasource": { "type": "loki", "uid": "${loki_ds}" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\"} |~ `\"event\":\"payment\\.`"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "인증 · 보안 이벤트 (auth.*)",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 9 },
      "datasource": { "type": "loki", "uid": "${loki_ds}" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\"} |~ `\"event\":\"auth\\.`"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    }
  ]
}
